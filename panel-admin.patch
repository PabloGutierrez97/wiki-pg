+}
+.pg-panel-body { padding: 1.25rem; }
+.pg-panel textarea { width: 100%; padding: 0.85rem; margin-bottom: 1rem; resize: vertical; font-family: inherit; line-height: 1.6; font-size: 0.875rem; box-sizing: border-box; }
+.pg-panel .pg-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; }
+.pg-panel .pg-status { color: var(--body-quiet-color); font-size: 0.8125rem; margin: 0; }
