<!DOCTYPE html><html lang="es" data-theme="light"><head>    <meta charset="UTF-8">    <meta name="viewport" content="width=device-width, initial-scale=1.0">    <title>{% block title %}Wiki PG{% endblock %}</title>    <meta name="description" content="{% block description %}Wiki técnica de Pablo Gutiérrez Gracia{% endblock %}">    <meta name="author" content="Pablo Gutiérrez Gracia">    <meta property="og:title" content="{% block og_title %}Wiki PG{% endblock %}">    <meta property="og:description" content="{% block og_description %}Wiki técnica de Pablo Gutiérrez Gracia{% endblock %}">    <meta property="og:type" content="website">    <meta property="og:url" content="https://wiki.pablogg.dev">    <link rel="canonical" href="https://wiki.pablogg.dev{% block canonical %}{% endblock %}">    {% load static %}    <link rel="stylesheet" href="{% static 'css/pygments.css' %}">    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">    <style>        /* ===== VARIABLES - OPTIMIZADAS TECH MINIMALIST ===== */        :root[data-theme="light"] {            --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;            --font-mono: 'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace;            --bg-primary:    #ffffff;    /* Fondo de elementos principales y tarjetas */            --bg-secondary:  #f8fafc;    /* Fondo general del contenido (Blanco roto) */            --bg-sidebar:    #ffffff;    /* Barra lateral limpia y blanca */            --nav-bg:        #ffffff;            --code-bg:       #f1f5f9;            --text-primary:  #334155;    /* Texto principal oscuro suave */            --text-secondary:#64748b;            --text-muted:    #94a3b8;            --sidebar-text:  #475569;    /* Texto de la barra lateral */            --sidebar-text-active: #0284c7; /* Color activo azul para los menús */            --border:        #e2e8f0;    /* Líneas divisorias sutiles */            --accent:        #0284c7;            --accent-hover:  #0369a1;            --shadow:        0 1px 3px 0 rgb(0 0 0 / 0.05), 0 1px 2px -1px rgb(0 0 0 / 0.05);            --shadow-md:     0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);            --radius-lg:     12px;            --radius-md:     8px;            --radius-sm:     4px;        }        :root[data-theme="dark"] {            --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;            --font-mono: 'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace;            --bg-primary:    #0b0f19;            --bg-secondary:  #151b2c;            --bg-sidebar:    #0b0f19;             --nav-bg:        #0b0f19;            --code-bg:       #1e293b;            --text-primary:  #cbd5e1;            --text-secondary:#94a3b8;            --text-muted:    #64748b;            --sidebar-text:  #64748b;            --sidebar-text-active: #38bdf8;            --border:        #1e293b;            --accent:        #38bdf8;            --accent-hover:  #0ea5e9;            --shadow:        0 1px 3px rgba(0,0,0,0.5);            --shadow-md:     0 4px 12px rgba(0,0,0,0.6);            --radius-lg:     12px;            --radius-md:     8px;            --radius-sm:     4px;        }        /* ===== RESET ===== */        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }        /* ===== BASE ===== */        body {            font-family: var(--font-sans);            background: var(--bg-secondary);            color: var(--text-primary);            line-height: 1.6;            transition: background 0.3s, color 0.3s;            display: flex;            flex-direction: column;            min-height: 100vh;        }        /* ===== TOPBAR (PC) ===== */        .topbar {            position: fixed;            top: 0; left: 0; right: 0;            height: 56px;            background: var(--nav-bg);            border-bottom: 1px solid var(--border);            display: flex;            align-items: center;            padding: 0 1.5rem;            justify-content: space-between;            z-index: 100;            box-shadow: var(--shadow);        }        .topbar-left { display: flex; align-items: center; gap: 1rem; }        .topbar-logo {            font-size: 1rem;            font-weight: 600;            color: var(--text-primary);            text-decoration: none;            display: flex;            align-items: center;            gap: 0.5rem;        }        .topbar-logo span {            background: var(--accent);            color: white;            padding: 0.2rem 0.5rem;            border-radius: 6px;            font-size: 0.8rem;        }        .topbar-right { display: flex; align-items: center; gap: 0.75rem; }        /* ===== HAMBURGER BUTTON MOVIL ===== */        .mobile-menu-btn {            display: none;            background: none;            border: none;            font-size: 1.2rem;            color: var(--text-primary);            cursor: pointer;            align-items: center;            justify-content: center;        }        /* ===== SEARCH ===== */        .search-form { display: flex; align-items: center; gap: 0.5rem; }        .search-input {            padding: 0.4rem 0.85rem;            border: 1px solid var(--border);            border-radius: 8px;            font-size: 0.875rem;            background: var(--bg-secondary);            color: var(--text-primary);            width: 220px;            transition: border 0.2s, width 0.2s;        }        .search-input:focus {            outline: none;            border-color: var(--accent);            width: 280px;        }        .search-btn {            padding: 0.4rem 0.85rem;            background: var(--accent);            color: white;            border: none;            border-radius: 8px;            cursor: pointer;            font-size: 0.875rem;            font-weight: 500;            transition: background 0.2s;        }        .search-btn:hover { background: var(--accent-hover); }        /* ===== THEME TOGGLE ===== */        .theme-toggle {            background: var(--bg-secondary);            border: 1px solid var(--border);            border-radius: 8px;            padding: 0.4rem 0.6rem;            cursor: pointer;            font-size: 1rem;            transition: background 0.2s;        }        .theme-toggle:hover { background: var(--border); }        /* ===== LAYOUT CONTENEDOR ===== */        .layout {            display: flex;            margin-top: 56px;            flex: 1;            min-height: calc(100vh - 56px);            width: 100%;        }        /* ===== SIDEBAR ===== */        .sidebar {            width: 260px;            min-width: 260px;            background: var(--bg-sidebar);            border-right: 1px solid var(--border);            padding: 1.5rem 0;            position: fixed;            top: 56px;            bottom: 0;            overflow-y: auto;            transition: transform 0.3s ease;            z-index: 99;        }        .sidebar-section { margin-bottom: 1.5rem; }        .sidebar-title {            font-size: 0.7rem;            font-weight: 600;            text-transform: uppercase;            letter-spacing: 0.08em;            color: var(--sidebar-text);            opacity: 0.6;            padding: 0 1.25rem;            margin-bottom: 0.4rem;        }        .sidebar-link {            display: flex;            align-items: center;            gap: 0.5rem;            padding: 0.4rem 1.25rem;            color: var(--sidebar-text);            text-decoration: none;            font-size: 0.875rem;            border-radius: 6px;            margin: 0 0.5rem;            transition: background 0.15s, color 0.15s;            cursor: pointer;            background: none;            border: none;            width: calc(100% - 1rem);            text-align: left;        }        .sidebar-link.active {            background: var(--accent) !important;            color: white !important;        }        /* Estilos Accordion */        .menu-toggle { justify-content: space-between; }        .chevron {            font-size: 0.65rem;            transition: transform 0.2s ease;        }        .submenu {            list-style: none;            padding-left: 1rem;            max-height: 0;            overflow: hidden;            transition: max-height 0.25s ease-out;        }        .menu-item.is-open .submenu { max-height: 500px; }        .menu-item.is-open .chevron { transform: rotate(90deg); }        .menu-item.is-open .menu-toggle { color: var(--sidebar-text-active); }        /* ===== MAIN CONTENT ===== */        .main {            margin-left: 260px;            flex: 1;            padding: 2.5rem 3rem;            max-width: 1400px;            transition: margin-left 0.3s ease, padding 0.3s ease;        }        /* ===== DISEÑO DASHBOARD ===== */        .dashboard-grid {            display: grid;            grid-template-columns: repeat(3, 1fr);            gap: 1.5rem;            margin-bottom: 2rem;            margin-top: 1rem;        }        .dashboard-card {            background: var(--bg-primary);            border: 1px solid var(--border);            border-radius: 16px;            padding: 1.5rem;            box-shadow: var(--shadow);            transition: transform 0.2s ease, box-shadow 0.2s ease;        }        .dashboard-card:hover {            transform: translateY(-2px);            box-shadow: var(--shadow-md);        }        .card-header {            display: flex;            align-items: center;            gap: 0.75rem;            font-size: 1.05rem;            font-weight: 600;            color: var(--text-primary);            margin-bottom: 1.25rem;            border-bottom: 1px solid var(--border);            padding-bottom: 0.75rem;        }        .card-icon-wrapper {            display: inline-flex;            align-items: center;            justify-content: center;            width: 30px;            height: 30px;            background: var(--code-bg);            color: var(--accent);            border-radius: 8px;            font-size: 0.95rem;        }        .card-list {            list-style: none;            padding: 0;            margin: 0;            display: flex;            flex-direction: column;            gap: 0.9rem;        }        .card-item {            display: flex;            align-items: center;            justify-content: space-between;            font-size: 0.9rem;            color: var(--text-secondary);        }        .card-item-left { display: flex; align-items: center; gap: 0.6rem; }        .card-item-meta { font-size: 0.8rem; color: var(--text-muted); }        /* Bloque Destacado */        .featured-section { margin-top: 2.5rem; }        .section-title {            font-size: 1.15rem;            font-weight: 600;            color: var(--text-primary);            margin-bottom: 1rem;        }        .featured-card {            background: var(--bg-primary);            border: 1px solid var(--border);            border-radius: 16px;            padding: 1.5rem;            box-shadow: var(--shadow);            position: relative;        }        .badge-group {            display: flex;            gap: 0.5rem;            margin-top: 1.25rem;        }        .badge-item {            background: var(--code-bg);            color: var(--text-secondary);            padding: 0.25rem 0.75rem;            border-radius: 20px;            font-size: 0.8rem;            border: 1px solid var(--border);        }        /* ===== CARDS STANDARD ===== */        .card {            background: var(--bg-primary);            border: 1px solid var(--border);            border-radius: 12px;            padding: 1.5rem;            margin-bottom: 1rem;            box-shadow: var(--shadow);            transition: box-shadow 0.2s, transform 0.2s;        }        .card:hover {            box-shadow: var(--shadow-md);            transform: translateY(-1px);        }        .card h3 a {            color: var(--text-primary);            text-decoration: none;            font-size: 1rem;            font-weight: 600;        }        .card h3 a:hover { color: var(--accent); }        .card-meta { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.3rem; }        .card-summary { font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.6rem; }        /* ===== NUEVO BOTÓN INTEGRADO VOLVERatrás ===== */        .btn-back {            display: inline-flex;            align-items: center;            gap: 0.5rem;            padding: 0.5rem 1rem;            background: var(--bg-primary);            border: 1px solid var(--border);            color: var(--text-secondary);            border-radius: var(--radius-md);            font-size: 0.875rem;            font-weight: 500;            text-decoration: none;            cursor: pointer;            transition: all 0.2s ease;            box-shadow: var(--shadow);            margin-bottom: 1.5rem;        }        .btn-back:hover {            background: var(--code-bg);            color: var(--accent);            border-color: var(--accent);            transform: translateX(-2px);        }        /* ===== ARTICLE ACCENTS ===== */        .article-header { margin-bottom: 2rem; }        .article-content { line-height: 1.8; }        .article-content h2 { font-size: 1.4rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; margin-top: 1.5rem; }        .article-content code {            background: var(--code-bg);            padding: 0.15rem 0.4rem;            border-radius: 4px;            font-size: 0.875em;            font-family: var(--font-mono);        }        /* === CORRECCIÓN TERMINAL REDONDEADA SIN CORTES === */        .article-content .highlight,        .article-content pre {            background: #1e1e1e !important;            border-radius: 16px !important;            overflow: hidden !important; /* Fuerza a que todo el contenido interno respete el borde redondo */            margin: 1.5rem 0;            box-shadow: 0 12px 32px rgba(0,0,0,0.35);            position: relative;            border: 1px solid rgba(255, 255, 255, 0.04);        }        .article-content .highlight pre {            margin: 0 !important;            border: none !important;            box-shadow: none !important;            border-radius: 0 !important;            overflow: hidden !important;        }        .article-content pre code {            display: block;            padding: 1.25rem;            background: none;            color: #d4d4d4;            font-size: 0.875rem;            font-family: var(--font-mono);            line-height: 1.7;        }        .article-content blockquote {            border-left: 4px solid var(--accent);            padding: 0.75rem 1rem;            background: var(--bg-secondary);            border-radius: 0 8px 8px 0;            margin: 1rem 0;            color: var(--text-secondary);        }        .breadcrumb { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.5rem; display: flex; gap: 0.5rem; }        .breadcrumb a { color: var(--text-muted); text-decoration: none; }        .breadcrumb a:hover { color: var(--accent); }        /* ===== FOOTER ===== */        footer {            margin-left: 260px;            padding: 1.5rem 3rem;            border-top: 1px solid var(--border);            font-size: 0.8rem;            color: var(--text-muted);            background: var(--bg-primary);            transition: margin-left 0.3s ease;        }        /* ===== RESPONSIVE MEDIA QUERIES ===== */        @media (max-width: 1024px) {            .dashboard-grid { grid-template-columns: repeat(2, 1fr); }        }        @media (max-width: 768px) {            .mobile-menu-btn { display: flex; }            .topbar-left { gap: 0.5rem; }            .search-input { width: 120px; }            .search-input:focus { width: 150px; }            .search-btn { display: none; }            .sidebar {                transform: translateX(-100%);                top: 56px;                height: calc(100vh - 56px);            }            .sidebar.is-active { transform: translateX(0); }            .dashboard-grid { grid-template-columns: 1fr; }            .main { margin-left: 0; padding: 1.5rem; }            footer { margin-left: 0; padding: 1.5rem; }        }        /* ===== CORRECCIÓN HOVER EN TEMAS ===== */        :root[data-theme="light"] .sidebar-link:hover, :root[data-theme="light"] .menu-toggle:hover {            background: #f1f5f9 !important;            color: var(--accent) !important;        }        :root[data-theme="dark"] .sidebar-link:hover, :root[data-theme="dark"] .menu-toggle:hover {            background: rgba(255, 255, 255, 0.05) !important;            color: #ffffff !important;        }    </style></head><body>    <header class="topbar">        <div class="topbar-left">            <button class="mobile-menu-btn" onclick="toggleMobileMenu()" title="Menú">☰</button>            <a href="/" class="topbar-logo">                <span>PG</span> Wiki            </a>        </div>        <div class="topbar-right">            <form method="get" action="/search/" class="search-form">                <input type="text" name="q" placeholder="Buscar artículos..." class="search-input">                <button type="submit" class="search-btn">Buscar</button>            </form>            <button class="theme-toggle" onclick="toggleTheme()" title="Cambiar tema">🌓</button>        </div>    </header>    <div class="layout">        <aside class="sidebar">            <div class="sidebar-section">                <div class="sidebar-title">Navegación</div>                <a href="/" class="sidebar-link">🏠 Inicio</a>                <a href="/search/" class="sidebar-link">🔍 Buscar</a>            </div>            <div class="sidebar-section">                <div class="sidebar-title">Categorías</div>                {% load wiki_tags %}                {% get_categories as categories %}                {% for cat in categories %}                    <div class="menu-item">                        {% if cat.subcategories.all %}                            <button class="sidebar-link menu-toggle">                                <span>📁 {{ cat.name }}</span>                                <span class="chevron">▼</span>                            </button>                            <ul class="submenu">                                {% for sub in cat.subcategories.all %}                                    <li>                                        <a href="{% url 'wiki:category_detail' sub.slug %}" class="sidebar-link">                                            📄 {{ sub.name }}                                        </a>                                    </li>                                {% endfor %}                            </ul>                        {% else %}                            <a href="{% url 'wiki:category_detail' cat.slug %}" class="sidebar-link">                                📁 {{ cat.name }}                            </a>                        {% endif %}                    </div>                {% endfor %}            </div>        </aside>        <main class="main">            {% block back_button %}{% endblock %}                        {% block content %}{% endblock %}        </main>    </div>    <footer>        <p>Wiki PG &copy; 2026 - Pablo Gutiérrez Gracia</p>    </footer>    <script>        // Lógica del tema (Dark/Light)        function toggleTheme() {            const html = document.documentElement;            if (html.getAttribute('data-theme') === 'light') {                html.setAttribute('data-theme', 'dark');                localStorage.setItem('theme', 'dark');            } else {                html.setAttribute('data-theme', 'light');                localStorage.setItem('theme', 'light');            }        }        const savedTheme = localStorage.getItem('theme') || 'light';        document.documentElement.setAttribute('data-theme', savedTheme);    </script>    <script>        // Desplegar menú lateral en móviles        function toggleMobileMenu() {            const sidebar = document.querySelector('.sidebar');            sidebar.classList.toggle('is-active');        }        // Lógica del Accordion para categorías Hijas        document.addEventListener('DOMContentLoaded', function() {            document.querySelectorAll('.menu-toggle').forEach(button => {                button.addEventListener('click', function(e) {                    e.preventDefault();                    const menuItem = button.parentElement;                    menuItem.classList.toggle('is-open');                });            });        });    </script>    <script>    document.addEventListener('DOMContentLoaded', function() {        document.querySelectorAll('.article-content pre').forEach(function(block) {            const container = block.closest('.highlight') || block;            if (container.querySelector('.mac-terminal-header')) return;            // Crear el botón de copiar            const button = document.createElement('button');            button.textContent = 'Copiar';            button.style.cssText = `                padding: 0.3rem 0.85rem;                background: rgba(255,255,255,0.08);                color: #aaa;                border: 1px solid rgba(255,255,255,0.15);                border-radius: 8px;                font-size: 0.72rem;                font-weight: 500;                letter-spacing: 0.03em;                cursor: pointer;                transition: all 0.2s;                font-family: inherit;                text-transform: uppercase;            `;            button.addEventListener('mouseenter', function() {                this.style.background = 'rgba(255,255,255,0.2)';                this.style.color = 'white';            });            button.addEventListener('mouseleave', function() {                this.style.background = 'rgba(255,255,255,0.08)';                this.style.color = '#aaa';            });            button.addEventListener('click', function() {                const codeBlock = container.querySelector('code') || container;                const code = codeBlock.innerText;                navigator.clipboard.writeText(code).then(() => {                    button.textContent = 'Copiado!';                    button.style.background = 'rgba(34,197,94,0.3)';                    button.style.color = '#4ade80';                    button.style.borderColor = 'rgba(34,197,94,0.4)';                    setTimeout(() => {                        button.textContent = 'Copiar';                        button.style.background = 'rgba(255,255,255,0.08)';                        button.style.color = '#aaa';                        button.style.borderColor = 'rgba(255,255,255,0.15)';                    }, 2000);                });            });            container.style.position = 'relative';            // Crear cabecera Mac Style            const header = document.createElement('div');            header.className = 'mac-terminal-header';            header.style.cssText = `                display: flex;                align-items: center;                justify-content: space-between;                background: #1a1a1a;                padding: 0.75rem 1.25rem;                border-bottom: 1px solid rgba(255, 255, 255, 0.05);            `;            const dots = document.createElement('div');            dots.style.cssText = `                display: flex;                align-items: center;                gap: 6px;            `;            dots.innerHTML = `                <span style="width:12px;height:12px;background:#ff5f57;border-radius:50%;display:inline-block;"></span>                <span style="width:12px;height:12px;background:#febc2e;border-radius:50%;display:inline-block;"></span>                <span style="width:12px;height:12px;background:#28c840;border-radius:50%;display:inline-block;"></span>            `;            header.appendChild(dots);            header.appendChild(button);            container.insertBefore(header, container.firstChild);        });    });    </script></body></html>