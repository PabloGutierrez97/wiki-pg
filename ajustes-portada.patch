From 94fbfaaae52c03eb1919f96bef4c0ae346952dda Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Pablo=20Guti=C3=A9rrez?= <gutipablo61@gmail.com>
Date: Thu, 15 Oct 2026 11:20:31 +0200
Subject: [PATCH] =?UTF-8?q?Portada:=20m=C3=A1s=20ancho=20en=20pantallas=20?=
 =?UTF-8?q?grandes=20y=20fechas=20m=C3=A1s=20claras?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- La rejilla de la portada llega hasta 1440px (antes 1180px) y gana
  separación entre columnas a partir de 1700px.
- La lista de últimos artículos indica también la fecha de actualización
  cuando difiere de la de publicación, y la línea bajo el buscador pasa a
  «Último artículo editado», para que las dos fechas no se contradigan.
- En móvil la fecha de publicación va encima del título.
- Versión del CSS a v=3 para invalidar la caché.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EPHLGVCrXe2rjmXBdTU8ah
---
 wiki/static/css/wiki.css      | 14 ++++++++++----
 wiki/templates/500.html       |  2 +-
 wiki/templates/wiki/base.html |  2 +-
 wiki/templates/wiki/home.html | 11 +++++++----
 4 files changed, 19 insertions(+), 10 deletions(-)

diff --git a/wiki/static/css/wiki.css b/wiki/static/css/wiki.css
index 84cf9d5..0378c33 100644
--- a/wiki/static/css/wiki.css
+++ b/wiki/static/css/wiki.css
@@ -372,7 +372,7 @@ a:hover { text-decoration-thickness: 2px; }
 
 /* ---------- Portada ---------- */
 
-.home-hero { max-width: 760px; margin-bottom: 3rem; }
+.home-hero { max-width: 820px; margin-bottom: 3rem; }
 .home-hero .page-title { font-size: clamp(1.95rem, 3.5vw, 2.45rem); }
 .home-hero .search { margin-top: 1.5rem; }
 .search-lg { max-width: 760px; }
@@ -395,7 +395,7 @@ a:hover { text-decoration-thickness: 2px; }
     display: grid;
     grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
     gap: 3rem;
-    max-width: 1180px;
+    max-width: 1440px;
 }
 .section-title {
     font-size: var(--fs-1);
@@ -417,7 +417,9 @@ a:hover { text-decoration-thickness: 2px; }
 .log time { color: var(--ink-3); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; padding-top: 0.12rem; }
 .log a { color: var(--ink); text-decoration: none; font-weight: 700; line-height: 1.35; }
 .log a:hover { color: var(--accent); text-decoration: underline; }
-.log .cat { display: block; color: var(--ink-3); font-size: var(--fs-sm); margin-top: 0.15rem; }
+.log .meta { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; color: var(--ink-3); font-size: var(--fs-sm); margin-top: 0.15rem; }
+.log .meta time { font-size: inherit; padding: 0; color: inherit; }
+.log .upd { color: var(--ink-3); }
 
 /* Categorías como listado de directorio */
 .dir { list-style: none; border-top: 1px solid var(--line); }
@@ -626,6 +628,10 @@ a:hover { text-decoration-thickness: 2px; }
 
 /* ---------- Responsive ---------- */
 
+@media (min-width: 1700px) {
+    .home-grid { gap: 5rem; }
+}
+
 @media (max-width: 1180px) {
     .home-grid { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; max-width: 760px; }
 }
@@ -685,7 +691,7 @@ a:hover { text-decoration-thickness: 2px; }
 
 @media (max-width: 520px) {
     .log li { grid-template-columns: minmax(0, 1fr); }
-    .log time { order: 2; padding: 0; }
+    .log li > time { padding: 0; }
     .prose { font-size: 1.0625rem; }
     .prose pre { font-size: 0.85rem; padding: 0.85rem 0.9rem; }
     .dir p, .dir .subs { margin-left: 0; }
diff --git a/wiki/templates/500.html b/wiki/templates/500.html
index 943433e..5007fd8 100644
--- a/wiki/templates/500.html
+++ b/wiki/templates/500.html
@@ -13,7 +13,7 @@
         })();
     </script>
     <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400&family=Atkinson+Hyperlegible+Next:wght@400;700&display=swap">
-    <link rel="stylesheet" href="{% static 'css/wiki.css' %}?v=2">
+    <link rel="stylesheet" href="{% static 'css/wiki.css' %}?v=3">
 </head>
 <body>
     <main class="main" style="margin: 0 auto; max-width: 720px;">
diff --git a/wiki/templates/wiki/base.html b/wiki/templates/wiki/base.html
index a86ab30..cf6d2a1 100644
--- a/wiki/templates/wiki/base.html
+++ b/wiki/templates/wiki/base.html
@@ -35,7 +35,7 @@
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
     <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;600&family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,700;1,400&display=swap">
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
-    <link rel="stylesheet" href="{% static 'css/wiki.css' %}?v=2">
+    <link rel="stylesheet" href="{% static 'css/wiki.css' %}?v=3">
     <link rel="stylesheet" href="{% static 'css/pygments.css' %}?v=2">
     {% block extra_head %}{% endblock %}
     <!-- Cloudflare Web Analytics -->
diff --git a/wiki/templates/wiki/home.html b/wiki/templates/wiki/home.html
index e42b4f4..ee590e0 100644
--- a/wiki/templates/wiki/home.html
+++ b/wiki/templates/wiki/home.html
@@ -19,8 +19,8 @@
 
     {% if last_updated %}
     <p class="home-last">
-        Última actualización: <a href="{% url 'wiki:article_detail' last_updated.slug %}">{{ last_updated.title }}</a>,
-        <time datetime="{{ last_updated.updated_at|date:'c' }}" class="tabular">{{ last_updated.updated_at|date:"d/m/Y" }}</time>
+        Último artículo editado: <a href="{% url 'wiki:article_detail' last_updated.slug %}">{{ last_updated.title }}</a>,
+        el <time datetime="{{ last_updated.updated_at|date:'c' }}" class="tabular">{{ last_updated.updated_at|date:"d/m/Y" }}</time>
     </p>
     {% endif %}
 </section>
@@ -32,10 +32,13 @@
         <ol class="log">
             {% for a in recent_articles %}
             <li>
-                <time datetime="{{ a.created_at|date:'c' }}">{{ a.created_at|date:"d/m/Y" }}</time>
+                <time datetime="{{ a.created_at|date:'c' }}" title="Fecha de publicación">{{ a.created_at|date:"d/m/Y" }}</time>
                 <div>
                     <a href="{% url 'wiki:article_detail' a.slug %}">{{ a.title }}</a>
-                    <span class="cat">{{ a.category.name }}</span>
+                    <span class="meta">
+                        <span>{{ a.category.name }}</span>
+                        {% if a.updated_at|date:"Ymd" != a.created_at|date:"Ymd" %}<span class="upd">Actualizado el <time datetime="{{ a.updated_at|date:'c' }}">{{ a.updated_at|date:"d/m/Y" }}</time></span>{% endif %}
+                    </span>
                 </div>
             </li>
             {% endfor %}
