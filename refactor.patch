@@ -0,0 +1,69 @@
+"""Conexión con LinkedIn y publicación manual desde el admin (solo staff con 2FA)."""
+import logging
+import secrets
+
+from django.http import JsonResponse
+from django.shortcuts import get_object_or_404, redirect
+from django.urls import reverse
+from django.views.decorators.http import require_POST
+
+from .. import linkedin
+from ..models import Article, LinkedInToken
+from ..security import staff_verificado
+
+log = logging.getLogger(__name__)
+
+SESION_STATE = 'linkedin_oauth_state'
+
+
+def _al_admin():
+    return redirect(reverse('admin:index'))
+
+
+@staff_verificado
+def linkedin_auth(request):
+    state = secrets.token_urlsafe(32)
+    request.session[SESION_STATE] = state
+    return redirect(linkedin.get_auth_url(state))
+
+
+@staff_verificado
+def linkedin_callback(request):
+    # El state impide que alguien te "conecte" su propia cuenta con un enlace preparado.
+    esperado = request.session.pop(SESION_STATE, None)
+    if not esperado or not secrets.compare_digest(esperado, request.GET.get('state', '')):
+        return _al_admin()
+
+    code = request.GET.get('code')
+    if not code:
+        return _al_admin()
+    access_token = linkedin.get_access_token(code).get('access_token')
+    if not access_token:
+        return _al_admin()
+
+    LinkedInToken(access_token=access_token,
+                  author_id=linkedin.get_profile(access_token).get('sub')).save()
+    return _al_admin()
+
+
+@staff_verificado
+@require_POST
+def linkedin_post(request, article_id):
+    token = LinkedInToken.get()
+    if not token:
+        return redirect(reverse('admin:wiki_linkedintoken_changelist'))
+    article = get_object_or_404(Article, pk=article_id)
+    text = request.POST.get('text', f'Nuevo artículo en mi wiki: {article.title}\n\n{article.url_publica}')
+    linkedin.post_to_linkedin(token.access_token, token.author_id, text[:3000])
+    return redirect(reverse('admin:wiki_article_change', args=[article_id]))
+
+
+@staff_verificado
+@require_POST
+def generate_linkedin_text(request, article_id):
+    article = get_object_or_404(Article, pk=article_id)
+    try:
+        return JsonResponse({'text': linkedin.texto_con_gemini(article)})
+    except Exception:
+        log.exception('Error generando el texto de LinkedIn con Gemini')
+        return JsonResponse({'error': 'Gemini no ha respondido; prueba de nuevo en un momento'}, status=502)
diff --git a/wiki/views/paginas.py b/wiki/views/paginas.py
new file mode 100644
index 0000000..6414afe
--- /dev/null
+++ b/wiki/views/paginas.py
@@ -0,0 +1,66 @@
+from django.shortcuts import get_object_or_404, render
+
+from ..models import Article, Category, Profile
+from ..rendering import articulo_html, resumen
+from ..templatetags.wiki_tags import get_categories
+
+MAX_TAG = 50
+
+
+def home(request):
+    publicados = Article.objects.publicados()
+    return render(request, 'wiki/home.html', {
+        'categories': get_categories(),
+        'recent_articles': publicados.select_related('category')[:6],
+        'total_articles': publicados.count(),
+        'total_categories': Category.objects.count(),
+        'last_updated': publicados.order_by('-updated_at').first(),
+    })
+
+
+def category_detail(request, slug):
+    category = get_object_or_404(Category, slug=slug)
+    articles = list(Article.objects.publicados().filter(category=category))
+    for article in articles:
+        article.summary = resumen(article)
+    return render(request, 'wiki/category_detail.html', {
+        'category': category,
+        'articles': articles,
+    })
+
+
+def article_detail(request, slug):
+    article = get_object_or_404(Article.objects.publicados(), slug=slug)
+    content_html, toc = articulo_html(article)
+
+    featured_image_url = None
+    if article.featured_image and article.featured_image.name:
+        try:
+            featured_image_url = article.featured_image.url
+        except ValueError:
+            pass
+
+    return render(request, 'wiki/article_detail.html', {
+        'article': article,
+        'content_html': content_html,
+        'toc': toc,
+        'reading_time': article.minutos_lectura,
+        'tags': article.tag_list,
+        'featured_image_url': featured_image_url,
+    })
+
+
+def tag_detail(request, tag):
+    tag = tag[:MAX_TAG]
+    return render(request, 'wiki/tag_detail.html', {
+        'tag': tag,
+        'articles': Article.objects.publicados().filter(tags__icontains=tag),
+    })
+
+
+def about(request):
+    profile = Profile.get()
+    return render(request, 'wiki/about.html', {
+        'profile': profile,
+        'stack': profile.stack_dict(),
+    })
