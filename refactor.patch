diff --git a/wiki/static/css/terminal.css b/wiki/static/css/terminal.css
new file mode 100644
index 0000000..86fe196
--- /dev/null
+++ b/wiki/static/css/terminal.css
@@ -0,0 +1,29 @@
+/* Widget del terminal (wiki/templates/wiki/_terminal_widget.html) */
+#term-window, #term-window * { text-align:left !important; box-sizing:border-box; }
+#term-output div { margin:0 !important; white-space:pre-wrap; word-break:break-word; }
+@media (max-width: 520px) {
+  #term-fab { bottom:16px; right:16px; width:48px !important; height:48px !important; }
+  #term-fab span { font-size:1.1rem !important; }
+  #term-window { bottom:76px !important; }
+  #term-window { width:calc(100vw - 16px) !important; right:8px !important; left:8px !important; }
+}
+/* ===== MODO CLARO TERMINAL ===== */
+:root[data-theme="light"] #term-fab { background: var(--ink) !important; border-color: var(--ink) !important; box-shadow: var(--shadow-pop) !important; }
+:root[data-theme="light"] #term-fab span { color: var(--bg) !important; }
+:root[data-theme="light"] #term-window { background: #f7f8fa !important; border-color: rgba(0,0,0,0.12) !important; box-shadow: 0 20px 60px rgba(0,0,0,0.18) !important; }
+:root[data-theme="light"] #term-header { background: #e9edf2 !important; border-bottom-color: rgba(0,0,0,0.06) !important; }
+:root[data-theme="light"] #term-body { color: #1f2937 !important; }
+:root[data-theme="light"] #term-input { color: #1f2937 !important; }
+:root[data-theme="light"] #term-output a { color: var(--accent) !important; }
+:root[data-theme="light"] #term-window span[style*="#28c840"] { color: #16a34a !important; }
+:root[data-theme="light"] #term-window span[style*="#4f8ef7"] { color: var(--accent) !important; }
+:root[data-theme="light"] #term-window span[style*="#febc2e"] { color: #b45309 !important; }
+:root[data-theme="light"] #term-window span[style*="#ff5f57"] { color: #dc2626 !important; }
+:root[data-theme="light"] #term-window span[style*="#888"] { color: #6b7280 !important; }
+:root[data-theme="light"] #term-window span[style*="#666"] { color: #9aa1ab !important; }
+#term-output .tpre { background: rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); border-radius:6px; padding:8px 10px; margin:6px 0; overflow-x:auto; white-space:pre; font-size:0.82rem; line-height:1.45; }
+#term-output .tcode { background: rgba(255,255,255,0.09); border-radius:4px; padding:1px 5px; font-size:0.9em; }
+#term-output strong { color:#ffffff; font-weight:700; }
+:root[data-theme="light"] #term-output .tpre { background:#eef1f5 !important; border-color:rgba(0,0,0,0.1) !important; }
+:root[data-theme="light"] #term-output .tcode { background:#e6e9ee !important; }
+:root[data-theme="light"] #term-output strong { color:#111827 !important; }
