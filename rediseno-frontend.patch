+/* =====================================================================
+   Wiki PG — hoja de estilos principal
+   Tipografía: Atkinson Hyperlegible Next (texto) y Mono (código y rutas).
+   Se eligió porque distingue l / I / 1 y 0 / O: importa al copiar IPs,
+   hostnames y comandos.
+   ===================================================================== */
+
+:root {
+    --font-sans: 'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', sans-serif;
+    --font-mono: 'Atkinson Hyperlegible Mono', ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace;
+
+    /* Escala tipográfica 1.25 sobre 16px */
+    --fs-sm:  0.875rem;
+    --fs-0:   1rem;
+    --fs-1:   1.25rem;
+    --fs-2:   1.5625rem;
+    --fs-3:   1.95rem;
+
+    --topbar-h: 56px;
+    --sidebar-w: 248px;
+    --measure: 68ch;
+
+    --radius: 6px;
+    --radius-code: 8px;
+
+    /* Tema claro */
+    --bg:          #F5F7F6;
+    --surface:     #FFFFFF;
+    --ink:         #1A2120;
+    --ink-2:       #4A5753;
+    --ink-3:       #66736F;
+    --line:        #DCE2DF;
+    --line-strong: #C4CDC9;
+    --accent:      #0A6B4E;
+    --accent-ink:  #FFFFFF;
+    --accent-soft: #E2F0EA;
+    --amber:       #8A5300;
+    --code-bg:     #161B1A;
+    --code-head:   #1E2524;
+    --code-ink:    #D7DFDC;
+    --inline-code: #E8EDEB;
+    --shadow-pop:  0 10px 30px rgb(16 24 22 / 0.14);
+
+    color-scheme: light;
+}
+
+:root[data-theme="dark"] {
+    --bg:          #151918;
+    --surface:     #1B201F;
+    --ink:         #DCE4E1;
+    --ink-2:       #A6B2AE;
+    --ink-3:       #8A9692;
+    --line:        #2A3230;
+    --line-strong: #3A4441;
+    --accent:      #5CC9A1;
+    --accent-ink:  #0E1413;
+    --accent-soft: #1C3229;
+    --amber:       #E2AE5A;
+    --code-bg:     #0F1312;
+    --code-head:   #161B1A;
+    --code-ink:    #D7DFDC;
+    --inline-code: #242B29;
+    --shadow-pop:  0 10px 30px rgb(0 0 0 / 0.5);
+
+    color-scheme: dark;
+}
+
+/* ---------- Base ---------- */
+
+*, *::before, *::after { box-sizing: border-box; }
+* { margin: 0; padding: 0; }
+
+html { -webkit-text-size-adjust: 100%; scroll-padding-top: calc(var(--topbar-h) + 1rem); }
+
+body {
+    font-family: var(--font-sans);
+    font-size: var(--fs-0);
+    line-height: 1.55;
+    background: var(--bg);
+    color: var(--ink);
+    min-height: 100vh;
+    display: flex;
+    flex-direction: column;
+}
+
+a { color: var(--accent); text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
+a:hover { text-decoration-thickness: 2px; }
+
+:focus-visible {
+    outline: 2px solid var(--accent);
+    outline-offset: 2px;
+    border-radius: 3px;
+}
+
+.visually-hidden {
+    position: absolute !important;
+    width: 1px; height: 1px;
+    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
+}
+
+.skip-link {
+    position: absolute; left: 1rem; top: -100px;
+    background: var(--accent); color: var(--accent-ink);
+    padding: 0.5rem 0.9rem; border-radius: var(--radius);
+    z-index: 300; text-decoration: none;
+}
+.skip-link:focus { top: 0.6rem; }
+
+.tabular { font-variant-numeric: tabular-nums; }
+
+/* ---------- Barra superior ---------- */
+
+.topbar {
+    position: fixed; inset: 0 0 auto 0;
+    height: var(--topbar-h);
+    z-index: 100;
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    grid-template-areas: "brand path tools";
+    align-items: center;
+    gap: 1.25rem;
+    padding: 0 1rem 0 1.25rem;
+    background: var(--surface);
+    border-bottom: 1px solid var(--line);
+}
+
+.brand {
+    grid-area: brand;
+    display: flex; align-items: center; gap: 0.55rem;
+    color: var(--ink); text-decoration: none;
+    font-weight: 700; font-size: 1.05rem;
+    width: calc(var(--sidebar-w) - 2.5rem);
+}
+.brand-mark {
+    display: inline-grid; place-items: center;
+    width: 30px; height: 30px;
+    background: var(--ink); color: var(--bg);
+    border-radius: var(--radius);
+    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600;
+    letter-spacing: -0.02em;
+}
+
+/* La ruta tipo shell: el elemento con más carácter del sitio */
+.shell-path {
+    grid-area: path;
+    min-width: 0;
+    font-family: var(--font-mono);
+    font-size: 0.95rem;
+    color: var(--ink-3);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+.shell-path ol { display: inline-flex; list-style: none; max-width: 100%; vertical-align: bottom; }
+.shell-path li { display: inline; white-space: nowrap; }
+.shell-path li:last-child { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
+.shell-path li + li::before { content: "/"; color: var(--ink-3); }
+.shell-path a { color: var(--ink-2); text-decoration: none; }
+.shell-path a:hover { color: var(--accent); text-decoration: underline; }
+.shell-path [aria-current="page"] { color: var(--ink); font-weight: 600; }
+.shell-path .prompt-user { color: var(--accent); }
+.shell-path .prompt-sep { color: var(--ink-3); }
+
+.tools { grid-area: tools; display: flex; align-items: center; gap: 0.5rem; }
+
+.icon-btn {
+    display: inline-grid; place-items: center;
+    width: 38px; height: 38px;
+    background: transparent;
+    border: 1px solid transparent;
+    border-radius: var(--radius);
+    color: var(--ink-2);
+    cursor: pointer;
+    font-size: 1rem;
+    text-decoration: none;
+}
+.icon-btn:hover { background: var(--bg); border-color: var(--line); color: var(--ink); }
+.menu-btn { display: none; }
+
+/* ---------- Buscador ---------- */
+
+.search { position: relative; }
+.search-field {
+    display: flex; align-items: center;
+    background: var(--bg);
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+}
+.search-field:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
+.search-field i { color: var(--ink-3); padding-left: 0.7rem; font-size: 0.85rem; }
+.search-input {
+    flex: 1; min-width: 0;
+    border: 0; background: transparent; color: var(--ink);
+    font: inherit; font-size: var(--fs-sm);
+    padding: 0.5rem 0.6rem;
+}
+.search-input:focus { outline: none; }
+.search-input::placeholder { color: var(--ink-3); }
+.search-input::-webkit-search-cancel-button { display: none; }
+.kbd {
+    font-family: var(--font-mono); font-size: 0.75rem;
+    color: var(--ink-3);
+    border: 1px solid var(--line-strong);
+    border-radius: 4px;
+    padding: 0 0.4rem;
+    margin-right: 0.5rem;
+    line-height: 1.4;
+}
+.search-field:focus-within .kbd { display: none; }
+.topbar .search { width: 300px; }
+
+.search-results {
+    position: absolute; top: calc(100% + 6px); left: 0; right: 0;
+    min-width: 300px;
+    background: var(--surface);
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    box-shadow: var(--shadow-pop);
+    list-style: none;
+    padding: 0.3rem;
+    z-index: 200;
+}
+.search-results[hidden] { display: none; }
+.search-results a {
+    display: block;
+    padding: 0.55rem 0.7rem;
+    border-radius: 4px;
+    color: var(--ink);
+    text-decoration: none;
+    font-size: var(--fs-sm);
+    line-height: 1.35;
+}
+.search-results small { display: block; color: var(--ink-3); font-size: 0.78rem; margin-top: 0.15rem; }
+.search-results a:hover,
+.search-results a[aria-selected="true"] { background: var(--accent-soft); }
+.search-results .search-all { color: var(--accent); }
+
+/* ---------- Estructura ---------- */
+
+.layout { display: flex; flex: 1; padding-top: var(--topbar-h); }
+
+.sidebar {
+    position: fixed; top: var(--topbar-h); bottom: 0; left: 0;
+    width: var(--sidebar-w);
+    overflow-y: auto;
+    padding: 1.25rem 0.75rem 2rem;
+    background: var(--bg);
+    border-right: 1px solid var(--line);
+    z-index: 90;
+}
+.sidebar-overlay {
+    display: none;
+    position: fixed; inset: var(--topbar-h) 0 0 0;
+    background: rgb(10 14 13 / 0.45);
+    z-index: 80;
+}
+
+.nav-list { list-style: none; }
+.nav-list + .nav-heading { margin-top: 1.5rem; }
+.nav-heading {
+    font-size: 0.8rem;
+    font-weight: 700;
+    color: var(--ink-3);
+    padding: 0 0.6rem;
+    margin-bottom: 0.35rem;
+}
+.nav-link {
+    display: flex; align-items: center; gap: 0.6rem;
+    padding: 0.38rem 0.6rem;
+    border-radius: var(--radius);
+    color: var(--ink-2);
+    text-decoration: none;
+    font-size: 0.94rem;
+    min-width: 0;
+}
+.nav-link i { width: 1.1em; text-align: center; color: var(--ink-3); font-size: 0.9em; flex-shrink: 0; }
+.nav-link .label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.nav-link .count { color: var(--ink-3); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
+.nav-link:hover { background: var(--surface); color: var(--ink); }
+.nav-link[aria-current="page"] { background: var(--accent-soft); color: var(--ink); font-weight: 700; }
+.nav-link[aria-current="page"] i { color: var(--accent); }
+
+.nav-group > summary { list-style: none; display: flex; align-items: center; border-radius: var(--radius); cursor: pointer; }
+.nav-group > summary::-webkit-details-marker { display: none; }
+.nav-group > summary .nav-link { flex: 1; }
+.nav-group > summary .chevron {
+    display: inline-grid; place-items: center;
+    width: 28px; height: 28px; flex-shrink: 0;
+    color: var(--ink-3); font-size: 0.7rem;
+    border-radius: 4px;
+}
+.nav-group > summary .chevron:hover { background: var(--surface); color: var(--ink); }
+.nav-group[open] > summary .chevron i { transform: rotate(90deg); }
+.nav-cats > li > .nav-link { margin-right: 28px; }
+.nav-group .nav-list {
+    margin: 0.1rem 0 0.25rem 1.15rem;
+    padding-left: 0.6rem;
+    border-left: 1px solid var(--line);
+}
+
+.main {
+    flex: 1;
+    min-width: 0;
+    margin-left: var(--sidebar-w);
+    padding: 2.5rem clamp(1.25rem, 4vw, 3.5rem) 4rem;
+}
+
+.site-footer {
+    margin-left: var(--sidebar-w);
+    padding: 1.25rem clamp(1.25rem, 4vw, 3.5rem);
+    border-top: 1px solid var(--line);
+    font-size: var(--fs-sm);
+    color: var(--ink-3);
+    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
+}
+.site-footer a { color: var(--ink-2); }
+
+/* ---------- Encabezados de página ---------- */
+
+.page-head { max-width: var(--measure); margin-bottom: 2rem; }
+.page-title {
+    font-size: var(--fs-3);
+    line-height: 1.15;
+    font-weight: 700;
+    letter-spacing: -0.015em;
+    text-wrap: balance;
+}
+.page-title i { color: var(--accent); font-size: 0.8em; margin-right: 0.35rem; }
+.page-lede { color: var(--ink-2); font-size: 1.0625rem; margin-top: 0.6rem; max-width: 60ch; }
+
+.chip-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
+.chip {
+    display: inline-flex; align-items: center; gap: 0.4rem;
+    padding: 0.25rem 0.7rem;
+    border: 1px solid var(--line-strong);
+    border-radius: 999px;
+    color: var(--ink-2);
+    font-size: var(--fs-sm);
+    text-decoration: none;
+}
+.chip:hover { border-color: var(--accent); color: var(--accent); }
+.chip .count { color: var(--ink-3); font-variant-numeric: tabular-nums; }
+
+/* ---------- Listas de artículos ---------- */
+
+.entry-list { list-style: none; max-width: 76ch; border-top: 1px solid var(--line); }
+.entry { padding: 1.15rem 0; border-bottom: 1px solid var(--line); }
+.entry-title { font-size: 1.125rem; line-height: 1.3; font-weight: 700; text-wrap: pretty; }
+.entry-title a { color: var(--ink); text-decoration: none; }
+.entry-title a:hover { color: var(--accent); text-decoration: underline; }
+.entry-meta {
+    display: flex; flex-wrap: wrap; gap: 0.25rem 1rem;
+    margin-top: 0.3rem;
+    color: var(--ink-3);
+    font-size: var(--fs-sm);
+    font-variant-numeric: tabular-nums;
+}
+.entry-meta a { color: var(--ink-2); }
+.entry-summary { margin-top: 0.45rem; color: var(--ink-2); font-size: 0.97rem; max-width: 68ch; }
+
+.result-count { color: var(--ink-3); font-size: var(--fs-sm); margin-bottom: 0.75rem; }
+
+.empty {
+    max-width: 60ch;
+    padding: 1.5rem 0;
+    color: var(--ink-2);
+}
+.empty strong { color: var(--ink); }
+.empty p + p { margin-top: 0.5rem; }
+
+.more-link { display: inline-block; margin-top: 1.75rem; font-weight: 700; }
+
+/* ---------- Portada ---------- */
+
+.home-hero { max-width: 760px; margin-bottom: 3rem; }
+.home-hero .page-title { font-size: clamp(1.95rem, 3.5vw, 2.45rem); }
+.home-hero .search { margin-top: 1.5rem; }
+.search-lg { max-width: 760px; }
+.search-lg .search-field { background: var(--surface); border-color: var(--line-strong); }
+.search-lg .search-field i { padding-left: 1rem; font-size: 1rem; }
+.search-lg .search-input { font-size: 1.0625rem; padding: 0.85rem 0.75rem; }
+.search-submit {
+    font: inherit; font-weight: 700; font-size: var(--fs-sm);
+    background: var(--accent); color: var(--accent-ink);
+    border: 0; border-radius: 4px;
+    padding: 0.55rem 1rem; margin-right: 0.4rem;
+    cursor: pointer;
+}
+.search-submit:hover { filter: brightness(1.08); }
+.page-head .search { margin-top: 1.25rem; }
+.home-last { margin-top: 0.9rem; color: var(--ink-3); font-size: var(--fs-sm); }
+.home-last a { color: var(--ink-2); }
+
+.home-grid {
+    display: grid;
+    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
+    gap: 3rem;
+    max-width: 1180px;
+}
+.section-title {
+    font-size: var(--fs-1);
+    font-weight: 700;
+    margin-bottom: 0.75rem;
+    display: flex; align-items: baseline; gap: 0.6rem;
+}
+.section-title .count { font-size: var(--fs-sm); color: var(--ink-3); font-weight: 400; }
+
+/* Últimos artículos: un registro con fecha a la izquierda */
+.log { list-style: none; border-top: 1px solid var(--line); }
+.log li {
+    display: grid;
+    grid-template-columns: 6.2rem minmax(0, 1fr);
+    gap: 0.25rem 1rem;
+    padding: 0.85rem 0;
+    border-bottom: 1px solid var(--line);
+}
+.log time { color: var(--ink-3); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; padding-top: 0.12rem; }
+.log a { color: var(--ink); text-decoration: none; font-weight: 700; line-height: 1.35; }
+.log a:hover { color: var(--accent); text-decoration: underline; }
+.log .cat { display: block; color: var(--ink-3); font-size: var(--fs-sm); margin-top: 0.15rem; }
+
+/* Categorías como listado de directorio */
+.dir { list-style: none; border-top: 1px solid var(--line); }
+.dir > li { padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
+.dir-row { display: flex; align-items: baseline; gap: 0.6rem; }
+.dir-row i { color: var(--accent); width: 1.15em; text-align: center; font-size: 0.95em; }
+.dir-row a { color: var(--ink); text-decoration: none; font-weight: 700; }
+.dir-row a:hover { color: var(--accent); text-decoration: underline; }
+.dir-row .count { margin-left: auto; color: var(--ink-3); font-size: var(--fs-sm); font-variant-numeric: tabular-nums; white-space: nowrap; }
+.dir p { color: var(--ink-2); font-size: 0.94rem; margin: 0.2rem 0 0 1.75rem; }
+.dir .subs { margin: 0.35rem 0 0 1.75rem; font-size: var(--fs-sm); color: var(--ink-3); }
+.dir .subs a { color: var(--ink-2); }
+
+/* ---------- Artículo ---------- */
+
+.article-layout {
+    display: grid;
+    grid-template-columns: minmax(0, var(--measure)) 15rem;
+    gap: clamp(2rem, 5vw, 4.5rem);
+    align-items: start;
+}
+
+.article { min-width: 0; }
+.article-head { margin-bottom: 2rem; }
+.article-meta {
+    display: flex; flex-wrap: wrap; gap: 0.3rem 1.25rem;
+    margin-top: 0.9rem;
+    color: var(--ink-3);
+    font-size: var(--fs-sm);
+    font-variant-numeric: tabular-nums;
+}
+.article-meta .updated { color: var(--amber); }
+
+.prose { font-size: 1.0625rem; line-height: 1.68; }
+.prose > * + * { margin-top: 1.1em; }
+.prose h2 {
+    font-size: var(--fs-2);
+    line-height: 1.2;
+    letter-spacing: -0.01em;
+    margin-top: 1.9em;
+    padding-top: 0.8em;
+    border-top: 1px solid var(--line);
+}
+.prose h3 { font-size: var(--fs-1); line-height: 1.3; margin-top: 1.8em; }
+.prose h4 { font-size: 1.0625rem; margin-top: 1.5em; }
+.prose h2 + *, .prose h3 + *, .prose h4 + * { margin-top: 0.6em; }
+.prose ul, .prose ol { padding-left: 1.4em; }
+.prose li + li { margin-top: 0.35em; }
+.prose li::marker { color: var(--ink-3); }
+.prose strong { font-weight: 700; color: var(--ink); }
+.prose img { max-width: 100%; height: auto; border-radius: var(--radius); }
+.prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.5em 0; }
+
+.prose :not(pre) > code {
+    font-family: var(--font-mono);
+    font-size: 0.88em;
+    background: var(--inline-code);
+    padding: 0.1em 0.35em;
+    border-radius: 4px;
+    overflow-wrap: anywhere;
+}
+
+.prose blockquote {
+    border-left: 3px solid var(--accent);
+    background: var(--accent-soft);
+    padding: 0.85em 1.1em;
+    border-radius: 0 var(--radius) var(--radius) 0;
+    color: var(--ink);
+}
+.prose blockquote > * + * { margin-top: 0.6em; }
+
+.table-wrapper { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
+.prose table { border-collapse: collapse; width: 100%; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
+.prose th, .prose td { text-align: left; padding: 0.55rem 0.9rem; border-bottom: 1px solid var(--line); vertical-align: top; }
+.prose th { background: var(--bg); font-weight: 700; white-space: nowrap; }
+.prose tr:last-child td { border-bottom: 0; }
+
+/* Bloques de código */
+.code-block {
+    background: var(--code-bg);
+    border-radius: var(--radius-code);
+    overflow: hidden;
+    border: 1px solid rgb(255 255 255 / 0.04);
+}
+.code-head {
+    display: flex; align-items: center; justify-content: space-between;
+    gap: 1rem;
+    padding: 0.35rem 0.5rem 0.35rem 1rem;
+    background: var(--code-head);
+    border-bottom: 1px solid rgb(255 255 255 / 0.06);
+    min-height: 2.4rem;
+}
+.code-lang { font-family: var(--font-mono); font-size: 0.8rem; color: #8FA19B; }
+.copy-btn {
+    font: inherit; font-size: 0.82rem; font-weight: 700;
+    color: #C9D3CF;
+    background: transparent;
+    border: 1px solid rgb(255 255 255 / 0.14);
+    border-radius: 4px;
+    padding: 0.2rem 0.65rem;
+    cursor: pointer;
+    display: inline-flex; align-items: center; gap: 0.4rem;
+}
+.copy-btn:hover { background: rgb(255 255 255 / 0.08); color: #fff; }
+.copy-btn.is-done { color: #7FD1B0; border-color: rgb(127 209 176 / 0.5); }
+.copy-btn:focus-visible { outline-color: #7FD1B0; }
+.prose .highlight { background: transparent; }
+.prose pre {
+    margin: 0;
+    padding: 1rem 1.15rem 1.1rem;
+    overflow-x: auto;
+    background: var(--code-bg);
+    color: var(--code-ink);
+    font-family: var(--font-mono);
+    font-size: 0.9rem;
+    line-height: 1.6;
+    tab-size: 4;
+}
+.prose pre code { font-family: inherit; background: none; padding: 0; }
+
+.article-foot { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
+.tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; list-style: none; font-size: 0.95rem; }
+.tag-list a { color: var(--ink-2); text-decoration: none; }
+.tag-list a:hover { color: var(--accent); text-decoration: underline; }
+.tag-list .hash { color: var(--ink-3); }
+
+/* Índice */
+.toc { position: sticky; top: calc(var(--topbar-h) + 2rem); font-size: 0.9rem; }
+.toc > summary {
+    list-style: none;
+    font-weight: 700;
+    color: var(--ink);
+    margin-bottom: 0.6rem;
+}
+.toc > summary::-webkit-details-marker { display: none; }
+.toc .toc ul, .toc ul { list-style: none; }
+.toc ul ul { padding-left: 0.85rem; }
+.toc a {
+    display: block;
+    padding: 0.28rem 0 0.28rem 0.85rem;
+    border-left: 2px solid var(--line);
+    color: var(--ink-3);
+    text-decoration: none;
+    line-height: 1.35;
+}
+.toc a:hover { color: var(--ink); }
+.toc a.is-current { color: var(--ink); border-left-color: var(--accent); font-weight: 700; }
+.toc .toc-body { max-height: calc(100vh - var(--topbar-h) - 6rem); overflow-y: auto; }
+
+.reading-progress {
+    position: fixed; top: var(--topbar-h); left: 0;
+    height: 2px; width: 100%;
+    background: var(--accent);
+    transform-origin: 0 50%;
+    transform: scaleX(0);
+    z-index: 101;
+}
+
+/* ---------- Sobre mí ---------- */
+
+.terminal {
+    max-width: 820px;
+    background: var(--code-bg);
+    color: #D7DFDC;
+    border-radius: 10px;
+    overflow: hidden;
+    border: 1px solid rgb(255 255 255 / 0.05);
+    font-family: var(--font-mono);
+    font-size: 0.93rem;
+}
+.terminal-head {
+    display: grid; grid-template-columns: 60px 1fr 60px; align-items: center;
+    padding: 0.65rem 1rem;
+    background: var(--code-head);
+    border-bottom: 1px solid rgb(255 255 255 / 0.06);
+}
+.terminal-dots { display: flex; gap: 6px; }
+.terminal-dots span { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
+.terminal-dots span:nth-child(2) { background: #febc2e; }
+.terminal-dots span:nth-child(3) { background: #28c840; }
+.terminal-title { text-align: center; color: #8FA19B; font-size: 0.8rem; }
+.terminal-body { padding: 1.25rem 1.4rem 1.5rem; line-height: 1.7; }
+.terminal-body .cmd { color: #EEF3F1; }
+.terminal-body .cmd + .out { margin-bottom: 1.1rem; }
+.terminal-body .ps-user { color: #7FD1B0; }
+.terminal-body .ps-path { color: #8EC5E8; }
+.terminal-body .ps-dim { color: #6F7D78; }
+.terminal-body .out { padding-left: 1rem; color: #C9D3CF; white-space: pre-line; }
+.terminal-body .out.prose-out { font-family: var(--font-sans); font-size: 0.97rem; line-height: 1.65; }
+.terminal-body .key { color: #E6C98F; }
+.terminal-body a { color: #8EC5E8; }
+.terminal-body .cursor {
+    display: inline-block; width: 0.55em; height: 1.1em;
+    background: #D7DFDC; vertical-align: -0.2em;
+    animation: blink 1.1s steps(1) infinite;
+}
+@keyframes blink { 50% { opacity: 0; } }
+
+/* ---------- Páginas de error ---------- */
+
+.error-page { max-width: 60ch; padding-top: 3rem; }
+.error-page .code { font-family: var(--font-mono); color: var(--ink-3); font-size: var(--fs-sm); }
+.error-page .page-title { margin-top: 0.4rem; }
+.error-page p { margin-top: 0.75rem; color: var(--ink-2); }
+.error-page .search { margin-top: 1.25rem; }
+
+/* ---------- Responsive ---------- */
+
+@media (max-width: 1180px) {
+    .home-grid { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; max-width: 760px; }
+}
+
+@media (max-width: 1100px) {
+    .article-layout { grid-template-columns: minmax(0, var(--measure)); }
+    .toc {
+        position: static;
+        grid-row: 1;
+        border: 1px solid var(--line);
+        border-radius: var(--radius);
+        padding: 0.7rem 1rem;
+        background: var(--surface);
+    }
+    .toc > summary { margin: 0; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
+    .toc > summary::after { content: "\f078"; font: var(--fa-font-solid); font-size: 0.7rem; color: var(--ink-3); }
+    .toc[open] > summary { margin-bottom: 0.6rem; }
+    .toc[open] > summary::after { transform: rotate(180deg); }
+    .toc .toc-body { max-height: none; }
+    .topbar .search { width: 240px; }
+}
+
+@media (max-width: 860px) {
+    :root { --topbar-h: 96px; }
+    .topbar {
+        grid-template-columns: auto minmax(0, 1fr) auto;
+        grid-template-rows: 56px 40px;
+        grid-template-areas: "menu brand tools" "path path path";
+        padding: 0 0.5rem 0 0.5rem;
+        gap: 0 0.5rem;
+    }
+    .menu-btn { display: inline-grid; grid-area: menu; }
+    .brand { width: auto; }
+    .shell-path {
+        border-top: 1px solid var(--line);
+        margin: 0 -0.5rem;
+        padding: 0 1rem;
+        line-height: 40px;
+        font-size: 0.875rem;
+        background: var(--bg);
+    }
+    .topbar .search { display: none; }
+
+    .sidebar {
+        transform: translateX(-100%);
+        transition: transform 0.2s ease;
+        background: var(--surface);
+        box-shadow: var(--shadow-pop);
+        width: min(300px, 85vw);
+    }
+    .sidebar.is-open { transform: none; }
+    .sidebar-overlay.is-open { display: block; }
+    .main, .site-footer { margin-left: 0; }
+    .main { padding-top: 1.75rem; }
+    .page-title { font-size: 1.75rem; }
+}
+
+@media (max-width: 520px) {
+    .log li { grid-template-columns: minmax(0, 1fr); }
+    .log time { order: 2; padding: 0; }
+    .prose { font-size: 1.0625rem; }
+    .prose pre { font-size: 0.85rem; padding: 0.85rem 0.9rem; }
+    .dir p, .dir .subs { margin-left: 0; }
+}
+
+.search-link { display: none !important; }
+@media (max-width: 860px) { .search-link { display: inline-grid !important; } }
+
+@media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
+}
+
+@media print {
+    .topbar, .sidebar, .sidebar-overlay, .site-footer, .toc, .reading-progress, .copy-btn, #term-fab, #term-window { display: none !important; }
+    .layout { padding: 0; }
+    .main { margin: 0; padding: 0; }
+    .article-layout { display: block; }
+}
diff --git a/wiki/static/js/wiki.js b/wiki/static/js/wiki.js
new file mode 100644
index 0000000..d495e10
--- /dev/null
+++ b/wiki/static/js/wiki.js
@@ -0,0 +1,245 @@
+/* Wiki PG — comportamiento de la interfaz */
+(function () {
+    'use strict';
+
+    var root = document.documentElement;
+    var mobile = window.matchMedia('(max-width: 860px)');
+
+    /* ---------- Tema ---------- */
+    function syncThemeButton() {
+        var dark = root.getAttribute('data-theme') === 'dark';
+        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
+            btn.setAttribute('aria-label', dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
+            btn.title = btn.getAttribute('aria-label');
+            var icon = btn.querySelector('i');
+            if (icon) icon.className = dark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
+        });
+    }
+    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
+            root.setAttribute('data-theme', next);
+            try { localStorage.setItem('theme', next); } catch (e) {}
+            syncThemeButton();
+        });
+    });
+    syncThemeButton();
+
+    /* ---------- Menú lateral en móvil ---------- */
+    var sidebar = document.getElementById('sidebar');
+    var overlay = document.querySelector('.sidebar-overlay');
+    var menuBtn = document.querySelector('[data-menu-toggle]');
+    function setMenu(open) {
+        if (!sidebar) return;
+        sidebar.classList.toggle('is-open', open);
+        overlay.classList.toggle('is-open', open);
+        if (menuBtn) {
+            menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
+            menuBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
+            menuBtn.querySelector('i').className = open ? 'fa-solid fa-xmark' : 'fa-solid fa-bars';
+        }
+        if (open) {
+            var first = sidebar.querySelector('a');
+            if (first) first.focus();
+        }
+    }
+    if (menuBtn) menuBtn.addEventListener('click', function () { setMenu(!sidebar.classList.contains('is-open')); });
+    if (overlay) overlay.addEventListener('click', function () { setMenu(false); });
+    document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && sidebar && sidebar.classList.contains('is-open')) { setMenu(false); menuBtn.focus(); }
+    });
+
+    /* La flecha abre y cierra; el nombre de la categoría navega */
+    document.querySelectorAll('.nav-group > summary .nav-link').forEach(function (link) {
+        link.addEventListener('click', function (e) { e.stopPropagation(); });
+    });
+
+    /* ---------- Buscador en vivo ---------- */
+    function esc(t) {
+        return String(t).replace(/[&<>"']/g, function (c) {
+            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+        });
+    }
+
+    document.querySelectorAll('[data-live-search]').forEach(function (input) {
+        var form = input.closest('form');
+        var box = form.querySelector('.search-results');
+        if (!box) return;
+        var timer = null, active = -1, lastQuery = '';
+
+        function items() { return box.querySelectorAll('a'); }
+        function close() { box.hidden = true; active = -1; input.setAttribute('aria-expanded', 'false'); }
+        function mark(i) {
+            var list = items();
+            list.forEach(function (a, j) { a.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
+            active = i;
+        }
+
+        input.setAttribute('role', 'combobox');
+        input.setAttribute('aria-autocomplete', 'list');
+        input.setAttribute('aria-expanded', 'false');
+
+        input.addEventListener('input', function () {
+            var q = input.value.trim();
+            clearTimeout(timer);
+            if (q.length < 2) { close(); return; }
+            timer = setTimeout(function () {
+                lastQuery = q;
+                fetch('/search/api/?q=' + encodeURIComponent(q))
+                    .then(function (r) { return r.json(); })
+                    .then(function (data) {
+                        if (q !== lastQuery) return;
+                        var html = data.results.map(function (a) {
+                            return '<li><a role="option" href="' + esc(a.url) + '">' + esc(a.title) +
+                                (a.category ? '<small>' + esc(a.category) + '</small>' : '') + '</a></li>';
+                        }).join('');
+                        html += '<li><a role="option" class="search-all" href="/search/?q=' + encodeURIComponent(q) + '">' +
+                            (data.results.length ? 'Ver todos los resultados de «' + esc(q) + '»' : 'Sin coincidencias en títulos. Buscar «' + esc(q) + '» en todo el texto') +
+                            '</a></li>';
+                        box.innerHTML = html;
+                        box.hidden = false;
+                        input.setAttribute('aria-expanded', 'true');
+                        active = -1;
+                    })
+                    .catch(close);
+            }, 180);
+        });
+
+        input.addEventListener('keydown', function (e) {
+            var list = items();
+            if (box.hidden || !list.length) return;
+            if (e.key === 'ArrowDown') { e.preventDefault(); mark((active + 1) % list.length); }
+            else if (e.key === 'ArrowUp') { e.preventDefault(); mark((active - 1 + list.length) % list.length); }
+            else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); window.location = list[active].href; }
+            else if (e.key === 'Escape') { close(); }
+        });
+
+        document.addEventListener('click', function (e) { if (!form.contains(e.target)) close(); });
+    });
+
+    /* «/» enfoca el buscador visible, como en muchas herramientas de terminal */
+    document.addEventListener('keydown', function (e) {
+        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
+        var t = e.target;
+        if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
+        var inputs = Array.prototype.filter.call(document.querySelectorAll('[data-live-search], .search-page-input'), function (i) {
+            return i.offsetParent !== null;
+        });
+        if (inputs.length) { e.preventDefault(); inputs[inputs.length - 1].focus(); }
+    });
+
+    /* ---------- Contenido de artículos ---------- */
+    var prose = document.querySelector('.prose');
+    if (prose) {
+        /* Tablas con scroll horizontal */
+        prose.querySelectorAll('table').forEach(function (table) {
+            if (table.parentElement.classList.contains('table-wrapper')) return;
+            var wrap = document.createElement('div');
+            wrap.className = 'table-wrapper';
+            table.parentNode.insertBefore(wrap, table);
+            wrap.appendChild(table);
+        });
+
+        /* Bloques de código: lenguaje + botón Copiar */
+        var LANGS = { bash: 'bash', sh: 'sh', shell: 'shell', console: 'consola', powershell: 'PowerShell', ps1: 'PowerShell',
+            yaml: 'YAML', yml: 'YAML', ini: 'ini', json: 'JSON', python: 'Python', py: 'Python', sql: 'SQL',
+            nginx: 'nginx', apacheconf: 'Apache', dockerfile: 'Dockerfile', xml: 'XML', html: 'HTML', toml: 'TOML',
+            jinja: 'Jinja', 'yaml+jinja': 'YAML', batch: 'cmd', bat: 'cmd', cfg: 'cfg', conf: 'conf', diff: 'diff', csharp: 'C#' };
+
+        prose.querySelectorAll('pre').forEach(function (pre) {
+            var container = pre.closest('.highlight') || pre;
+            if (container.parentElement.classList.contains('code-block')) return;
+            var code = pre.querySelector('code') || pre;
+            var m = (code.className || '').match(/language-([\w+#-]+)/);
+            var lang = m ? (LANGS[m[1].toLowerCase()] || m[1]) : '';
+            if (lang === 'text') lang = '';
+
+            var block = document.createElement('figure');
+            block.className = 'code-block';
+            var head = document.createElement('figcaption');
+            head.className = 'code-head';
+            head.innerHTML = '<span class="code-lang">' + esc(lang) + '</span>' +
+                '<button type="button" class="copy-btn"><i class="fa-regular fa-copy" aria-hidden="true"></i><span>Copiar</span></button>';
+            container.parentNode.insertBefore(block, container);
+            block.appendChild(head);
+            block.appendChild(container);
+
+            var btn = head.querySelector('.copy-btn');
+            var label = btn.querySelector('span');
+            if (lang) btn.setAttribute('aria-label', 'Copiar código ' + lang);
+            btn.addEventListener('click', function () {
+                var text = code.innerText.replace(/\n$/, '');
+                var done = function () {
+                    label.textContent = 'Copiado';
+                    btn.classList.add('is-done');
+                    btn.querySelector('i').className = 'fa-solid fa-check';
+                    setTimeout(function () {
+                        label.textContent = 'Copiar';
+                        btn.classList.remove('is-done');
+                        btn.querySelector('i').className = 'fa-regular fa-copy';
+                    }, 1800);
+                };
+                if (navigator.clipboard && window.isSecureContext) {
+                    navigator.clipboard.writeText(text).then(done);
+                } else {
+                    var ta = document.createElement('textarea');
+                    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
+                    document.body.appendChild(ta); ta.select();
+                    try { document.execCommand('copy'); done(); } catch (e) {}
+                    ta.remove();
+                }
+            });
+        });
+
+        /* Barra de progreso de lectura */
+        var bar = document.querySelector('.reading-progress');
+        if (bar) {
+            var ticking = false;
+            var update = function () {
+                var top = prose.getBoundingClientRect().top + window.scrollY;
+                var end = top + prose.offsetHeight - window.innerHeight;
+                var p = end > top ? (window.scrollY - top) / (end - top) : 1;
+                bar.style.transform = 'scaleX(' + Math.min(1, Math.max(0, p)) + ')';
+                ticking = false;
+            };
+            window.addEventListener('scroll', function () {
+                if (!ticking) { ticking = true; requestAnimationFrame(update); }
+            }, { passive: true });
+            update();
+        }
+
+        /* Índice: marca la sección que se está leyendo */
+        var toc = document.querySelector('.toc');
+        if (toc) {
+            var tocQuery = window.matchMedia('(max-width: 1100px)');
+            if (tocQuery.matches) toc.removeAttribute('open');
+            tocQuery.addEventListener('change', function (e) { if (!e.matches) toc.setAttribute('open', ''); });
+            toc.querySelector('summary').addEventListener('click', function (e) {
+                if (!tocQuery.matches) e.preventDefault();
+            });
+
+            var links = {};
+            toc.querySelectorAll('a[href^="#"]').forEach(function (a) {
+                links[decodeURIComponent(a.getAttribute('href').slice(1))] = a;
+                a.addEventListener('click', function () { if (tocQuery.matches) toc.removeAttribute('open'); });
+            });
+            var heads = Array.prototype.filter.call(prose.querySelectorAll('h2[id], h3[id], h4[id]'), function (h) { return links[h.id]; });
+            if (heads.length && 'IntersectionObserver' in window) {
+                var current = null;
+                var setCurrent = function (id) {
+                    if (current === id) return;
+                    if (current && links[current]) links[current].classList.remove('is-current');
+                    current = id;
+                    if (links[id]) links[id].classList.add('is-current');
+                };
+                var io = new IntersectionObserver(function () {
+                    var line = (parseInt(getComputedStyle(root).getPropertyValue('--topbar-h'), 10) || 56) + 40;
+                    var id = heads[0].id;
+                    heads.forEach(function (h) { if (h.getBoundingClientRect().top <= line) id = h.id; });
+                    setCurrent(id);
+                }, { rootMargin: '0px 0px -60% 0px', threshold: [0, 1] });
+                heads.forEach(function (h) { io.observe(h); });
+            }
+        }
+    }
+})();
