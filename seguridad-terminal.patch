From e7dad830c2d01f6e3d71c2a4aa7eb4861e658948 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Pablo=20Guti=C3=A9rrez=20Gracia?= <pgutigracia@gmail.com>
Date: Sun, 18 Oct 2026 18:27:08 +0200
Subject: [PATCH] Seguridad: escapar comillas en el terminal y exigir ADMIN_URL
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- terminal.js: esc() no escapaba comillas y el texto acaba dentro del
  href de los enlaces. Una URL con " en la salida (por ejemplo, forzada en
  la respuesta de la IA) podía añadir atributos como onmouseover y
  ejecutar JavaScript, y la respuesta quedaba 15 min en caché para quien
  hiciera la misma pregunta.
- settings: ADMIN_URL ya no tiene valor por defecto. La ruta antigua está
  en el historial público; si el .env la perdiera, el admin volvería a ella
  sin avisar. Ahora Django no arranca sin ADMIN_URL.
---
 wiki/static/js/terminal.js                | 7 ++++++-
 wiki/templates/wiki/_terminal_widget.html | 2 +-
 wiki_pg/settings.py                       | 8 +++++++-
 3 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/wiki/static/js/terminal.js b/wiki/static/js/terminal.js
index b0208ad..5019171 100644
--- a/wiki/static/js/terminal.js
+++ b/wiki/static/js/terminal.js
@@ -23,7 +23,12 @@
     'gris': '#888', 'rojo': '#ff5f57'
   };
 
-  function esc(t) { return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
+  // Escapa también las comillas: el texto acaba dentro de atributos (href de los enlaces)
+  // y una URL con " podría añadir atributos como onmouseover.
+  function esc(t) {
+    return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
+            .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
+  }
 
   function colorear(texto) {
     var t = esc(texto);
diff --git a/wiki/templates/wiki/_terminal_widget.html b/wiki/templates/wiki/_terminal_widget.html
index aa4ce91..2f93159 100644
--- a/wiki/templates/wiki/_terminal_widget.html
+++ b/wiki/templates/wiki/_terminal_widget.html
@@ -20,4 +20,4 @@
     </div>
   </div>
 </div>
-<script src="{% static 'js/terminal.js' %}?v=1" defer></script>
+<script src="{% static 'js/terminal.js' %}?v=2" defer></script>
diff --git a/wiki_pg/settings.py b/wiki_pg/settings.py
index 914f937..b509532 100644
--- a/wiki_pg/settings.py
+++ b/wiki_pg/settings.py
@@ -17,7 +17,13 @@ ALLOWED_HOSTS = ['192.168.0.63', 'localhost', '127.0.0.1', 'wiki.pablogg.dev']
 
 # Ruta del admin real. Va en el .env para que no quede en el repositorio público:
 # si está aquí, cualquiera que lea GitHub se salta el honeypot de /admin/.
-ADMIN_URL = os.getenv('ADMIN_URL', 'termistawk').strip('/') + '/'
+# Sin valor por defecto: la ruta antigua está en el historial público de GitHub, y
+# si el .env la perdiera el admin volvería a ella sin avisar. Mejor no arrancar.
+ADMIN_URL = os.getenv('ADMIN_URL', '').strip('/')
+if not ADMIN_URL:
+    from django.core.exceptions import ImproperlyConfigured
+    raise ImproperlyConfigured('Falta ADMIN_URL en el .env')
+ADMIN_URL += '/'
 
 # URL pública de la wiki y del código (enlaces de LinkedIn, terminal, IA...).
 SITE_URL = os.getenv('SITE_URL', 'https://wiki.pablogg.dev').rstrip('/')
-- 
